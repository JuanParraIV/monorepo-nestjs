{
  "nodes": {
    "http-ms-products": {
      "name": "http-ms-products",
      "type": "app",
      "data": {
        "root": "apps/http-ms-products",
        "targets": {
          "eslint:lint": {
            "cache": true,
            "options": {
              "cwd": "apps/http-ms-products",
              "env": {
                "ESLINT_USE_FLAT_CONFIG": "false"
              },
              "command": "eslint ."
            },
            "inputs": [
              "default",
              "^default",
              "{workspaceRoot}/.eslintrc.json",
              "{projectRoot}/.eslintrc.json",
              "{workspaceRoot}/tools/eslint-rules/**/*",
              {
                "externalDependencies": [
                  "eslint"
                ]
              }
            ],
            "outputs": [
              "{options.outputFile}"
            ],
            "metadata": {
              "technologies": [
                "eslint"
              ],
              "description": "Runs ESLint on project",
              "help": {
                "command": "bun eslint --help",
                "example": {
                  "options": {
                    "max-warnings": 0
                  }
                }
              }
            },
            "executor": "nx:run-commands",
            "configurations": {},
            "parallelism": true
          },
          "build": {
            "executor": "@nx/rspack:rspack",
            "outputs": [
              "{options.outputPath}"
            ],
            "defaultConfiguration": "production",
            "options": {
              "target": "node",
              "outputPath": "dist/apps/http-ms-products",
              "main": "apps/http-ms-products/src/main.ts",
              "tsConfig": "apps/http-ms-products/tsconfig.app.json",
              "rspackConfig": "apps/http-ms-products/rspack.config.js",
              "assets": [
                "apps/http-ms-products/src/assets"
              ]
            },
            "configurations": {
              "development": {
                "mode": "development"
              },
              "production": {
                "mode": "production",
                "sourceMap": false
              }
            },
            "parallelism": true,
            "dependsOn": [
              "^build"
            ],
            "inputs": [
              "production",
              "^production"
            ]
          },
          "serve": {
            "executor": "@nx/js:node",
            "defaultConfiguration": "development",
            "options": {
              "buildTarget": "http-ms-products:build"
            },
            "configurations": {
              "development": {
                "buildTarget": "http-ms-products:build:development"
              },
              "production": {
                "buildTarget": "http-ms-products:build:production"
              }
            },
            "parallelism": true
          },
          "lint": {
            "executor": "@nx/linter:eslint",
            "outputs": [
              "{options.outputFile}"
            ],
            "options": {
              "lintFilePatterns": [
                "apps/http-ms-products/**/*.ts"
              ]
            },
            "configurations": {},
            "parallelism": true,
            "inputs": [
              "default",
              "{workspaceRoot}/.eslintrc.json",
              "{workspaceRoot}/.eslintignore"
            ]
          },
          "test": {
            "executor": "@nx/jest:jest",
            "outputs": [
              "{workspaceRoot}/coverage/{projectRoot}"
            ],
            "options": {
              "jestConfig": "apps/http-ms-products/jest.config.ts",
              "passWithNoTests": true
            },
            "configurations": {
              "ci": {
                "ci": true,
                "codeCoverage": true
              }
            },
            "parallelism": true,
            "inputs": [
              "default",
              "^production",
              "{workspaceRoot}/jest.preset.js"
            ]
          }
        },
        "name": "http-ms-products",
        "$schema": "../../node_modules/nx/schemas/project-schema.json",
        "sourceRoot": "apps/http-ms-products/src",
        "projectType": "application",
        "tags": [],
        "implicitDependencies": []
      }
    },
